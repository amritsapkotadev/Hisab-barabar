{
  "expo": {
    "name": "Hisab Barabar",
    "slug": "hisab-barabar",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/new_logo_icon.png",
    "scheme": "hisabbarabar",
    "userInterfaceStyle": "automatic",
    "androidStatusBar": {
      "barStyle": "light-content",
      "backgroundColor": "#000000",
      "translucent": false
    },
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hisabbarabar.app",
      "associatedDomains": [
        "applinks:hisabbarabar.qzz.io"
      ],
      "infoPlist": {
        "NSCameraUsageDescription": "Allow Hisab Barabar to scan group invite QR codes and take profile photos.",
        "NSPhotoLibraryUsageDescription": "Allow Hisab Barabar to choose a profile photo."
      },
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "android": {
      "package": "com.hisabbarabar.app",
      "softwareKeyboardLayoutMode": "pan",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/new_logo_icon.png",
        "backgroundColor": "#000000"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": {
            "scheme": "https",
            "host": "hisabbarabar.qzz.io",
            "pathPrefix": "/join"
          },
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "data": {
            "scheme": "hisabbarabar",
            "host": "*"
          },
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.WAKE_LOCK",
        "android.permission.VIBRATE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/new_logo.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://hisabbarabar.qzz.io"
        }
      ],
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Hisab Barabar to scan group invite QR codes and take profile photos.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Hisab Barabar to choose a profile photo.",
          "cameraPermission": "Allow Hisab Barabar to take a profile photo.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "android": {
            "backgroundColor": "#000000",
            "drawable": {
              "icon": "./assets/splash_transparent.xml"
            }
          }
        }
      ],
      [
        "@react-native-firebase/app",
        {
          "ios": false
        }
      ],
      [
        "@react-native-firebase/messaging",
        {
          "ios": false
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.858936552466-rfqc656f5ai8se17grq9a4989t008ni4"
        }
      ],
      "expo-secure-store",
      "expo-localization",
      "expo-sqlite",
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "APP_DOMAIN": "hisabbarabar.qzz.io",
      "router": {
        "origin": "https://hisabbarabar.qzz.io"
      },
      "eas": {
        "projectId": "46e69d5d-c5a1-4336-bc71-1eeaa9a7ce9e"
      }
    },
    "owner": "amritsapkota"
  }
}
