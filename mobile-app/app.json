{
  "expo": {
    "name": "Hisab Barabar",
    "slug": "hisab-barabar",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "splitsaathi",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hisabbarabar.app",
      "associatedDomains": [
        "applinks:hisabbarabar.qzz.io"
      ],
      "infoPlist": {
        "NSCameraUsageDescription": "Allow $(PRODUCT_NAME) to access your camera"
      }
    },
    "android": {
      "package": "com.hisabbarabar.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#4f46e5"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": {
            "scheme": "https",
            "host": "hisabbarabar.qzz.io",
            "pathPrefix": "/join"
          },
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "data": {
            "scheme": "hisabbarabar",
            "host": "*"
          },
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://hisabbarabar.qzz.io"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "react-native-vision-camera",
      [
        "@react-native-firebase/app",
        {
          "ios": false
        }
      ],
      [
        "@react-native-firebase/messaging",
        {
          "ios": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": "https://hisabbarabar.qzz.io"
      },
      "eas": {
        "projectId": "46e69d5d-c5a1-4336-bc71-1eeaa9a7ce9e"
      }
    },
    "owner": "amritsapkota"
  }
}
