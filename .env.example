# Database Configuration
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/splitsaathi?retryWrites=true&w=majority

# JWT Secret (Use a long random string - minimum 32 characters)
JWT_SECRET=your-super-secret-jwt-key-at-least-32-characters-long

# Server Configuration
NODE_ENV=development
PORT=5051

# App Domain (Update this to your deployment URL)
APP_DOMAIN=localhost:5051

# Google OAuth (Optional - for Google Sign-In)
GOOGLE_CLIENT_ID_WEB=your-google-client-id-web.apps.googleusercontent.com
GOOGLE_CLIENT_ID_IOS=your-google-client-id-ios.apps.googleusercontent.com
GOOGLE_CLIENT_ID_ANDROID=your-google-client-id-android.apps.googleusercontent.com

# For Production on Render.com, set APP_DOMAIN to:
# APP_DOMAIN=your-app-name.onrender.com
