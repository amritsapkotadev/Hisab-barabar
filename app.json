{
  "expo": {
    "name": "SplitSaathi",
    "slug": "hisab-barabar",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "splitsaathi",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.splitsaathi.app",
      "associatedDomains": [
        "applinks:splitsaathi.up.railway.app"
      ],
      "infoPlist": {
        "NSCameraUsageDescription": "Allow $(PRODUCT_NAME) to access your camera"
      }
    },
    "android": {
      "googleServicesFile": "./android/app/google-services.json",
      "package": "com.splitsaathi.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#4f46e5"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": {
            "scheme": "https",
            "host": "splitsaathi.up.railway.app",
            "pathPrefix": "/join"
          },
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "data": {
            "scheme": "splitsaathi",
            "host": "*"
          },
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://splitsaathi.up.railway.app"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "react-native-vision-camera",
      "@react-native-firebase/app"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": "https://splitsaathi.up.railway.app"
      },
      "eas": {
        "projectId": "e856cf73-a3f0-464a-85d5-4f45bde7ca5d"
      }
    },
    "owner": "amritsapkota"
  }
}